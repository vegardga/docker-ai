# isolated ai environments for Apple container
#
# OBS: batman får sudo-rettigheter med dette oppsettet
#
# usage:
#   container build -t docker-ai . --no-cache
FROM ubuntu:24.04

# no prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# upgrade and install
RUN apt-get update && apt-get install -y --no-install-recommends \
    btop \
    make \
    gcc \
    fd-find \
    xclip \
    less \
    git \
    openssh-client \
    build-essential \
    zsh \
    iptables \
    ipset \
    iproute2 \
    dnsutils \
    gnupg2 \
    sudo \
    curl \
    git \
    gpg \
    jq \
    ripgrep \
    tmux \
    tree \
    unzip \
    vim \
    wget \
    ca-certificates \
    openjdk-17-jdk \
    openjdk-21-jdk \
    python3 python3-pip python3-venv \
    locales \
    && locale-gen nb_NO.UTF-8 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set the default editor and visual
# c-x e in opencode
ENV EDITOR=nvim
ENV VISUAL=nvim
ENV GIT_EDITOR=nvim

# Set the default shell to zsh rather than sh
ENV SHELL=/bin/zsh

# Miljø-variabel som brukes av entrypoint
ENV OPENCODE_AUTH_TOKEN=""
ENV GITHUB_TOKEN=""

# java
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-arm64
ENV PATH="$JAVA_HOME/bin:$PATH"

# norsk
ENV LANG=nb_NO.UTF-8
ENV LANGUAGE=nb_NO:nb
ENV LC_ALL=nb_NO.UTF-8

# tmux, and markdown rendering in opencode
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

# Copy the custom entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

# Grant execution permissions to the script
RUN chmod +x /usr/local/bin/entrypoint.sh

# non root user
# RUN userdel -r ubuntu \
#     && useradd --uid 1000 --create-home --shell /bin/bash batman \
#     && groupadd -r render \
#     && usermod -aG video,render batman

# Opprett en ikke-root-bruker, kalt "batman"
RUN useradd --create-home --shell /bin/bash batman

# Legg til batman i sudo-gruppen og disable passord-prompts
RUN usermod -aG sudo batman && \
    echo "batman ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Legg til .local/bin på path
ENV PATH="/home/batman/.local/bin:$PATH"

# Bytt til "batman" og endre arbeidsmappen til hjem-mappen
USER batman
WORKDIR /home/batman

# batman ownership of folders we later mount using -v
RUN mkdir -p /home/batman/.local/state && \
    mkdir -p /home/batman/.local/share/opencode && \
    mkdir -p /home/batman/.config && \
    mkdir -p /home/batman/.config/opencode && \
    mkdir -p /home/batman/.local/bin

# dotfiles
RUN git clone https://github.com/vegardga/dotfiles && \
    chmod u+x dotfiles/setup && \
    cd dotfiles && \
    ./setup && \
    cd ..

# Copy config file
COPY auth.json /home/batman/.local/share/opencode/auth.json
COPY gitconfig-ai /home/batman/.gitconfig

# Download and install the latest Neovim release
RUN curl -LO https://github.com/neovim/neovim/releases/latest/download/nvim-linux-arm64.tar.gz \
    && tar -C /home/batman/.local/bin -xzf nvim-linux-arm64.tar.gz \
    && rm nvim-linux-arm64.tar.gz

# Add Neovim to the system PATH
ENV PATH="/home/batman/.local/bin/nvim-linux-arm64/bin:$PATH"

# Download and install the latest tree-sitter-cli
RUN curl -LO https://github.com/tree-sitter/tree-sitter/releases/download/v0.26.11/tree-sitter-linux-arm64.gz \
    && gunzip -c tree-sitter-linux-arm64.gz > /home/batman/.local/bin/tree-sitter \
    && rm tree-sitter-linux-arm64.gz \
    && chmod +x /home/batman/.local/bin/tree-sitter

# kickstart-nvim
RUN git clone https://github.com/vegardga/kickstart.nvim.git "/home/batman/.config/nvim"

# PREINSTALL PLUGINS: Run headless sync using native vim.pack
RUN nvim --headless -c "lua vim.pack.add()" -c "qa"

# Run the mise installer and configure the target path
RUN curl -fsSL https://mise.run | MISE_INSTALL_PATH=/home/batman/.local/bin/mise sh

# ai
RUN curl -fsSL https://opencode.ai/install | bash
 # && curl -fsSL https://bun.com/install | bash \

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Default oppstartskommando
CMD ["/bin/bash"]
